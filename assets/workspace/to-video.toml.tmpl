# 工作区机制配置（skill 的 check_series / verify_skeleton 读取；区别于各集 pipeline.toml）。
# 各节都属「内容策略随内容走」，skill 不携带任何具体系列或集的身份。

[check_series]
# 宿主仓库（工作区所在的 git 仓库根）级受检文件，PROJECT 根相对 glob。
# 例（嵌套在宿主仓内的工作区）：
# project_globs = ["docs/.agents/knowledge-map.md", "CHANGELOG.md"]
project_globs = []

# 规则 7「去站点化」适用的课程型系列 id（空 = 规则不激活）。
# 例：course_series_ids = ["claude-code-explained"]
course_series_ids = []

# 规则 8「下集预告卡同步」适用的系列 id（配了统一收尾装置的系列）。
next_card_series_ids = []

# 骨架合法偏离登记（verify_skeleton 读取；缺省 = 无登记）。字段与指纹口径见 skill 的
# assets/video-skeleton/skeleton.toml「合法偏离登记」「骨架分代」两节。例：
# [[skeleton.drift]]
# episode = "demo-video"
# path = "video/src/components/cards.tsx"
# fingerprint = "<verify_skeleton 报告里该文件的 12 位当前值>"
# reason = "本集 Pill 加描边适配浅底主题；撤销条件：模板吸收该变体后同步删除本条"
