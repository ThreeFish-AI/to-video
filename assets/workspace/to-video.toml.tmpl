# 工作区机制配置（skill 的 check_series 等工具读取；区别于各集 pipeline.toml）。
# 三组键都属「内容策略随内容走」，skill 不携带任何具体系列的身份。

[check_series]
# 宿主仓库（工作区所在的 git 仓库根）级受检文件，PROJECT 根相对 glob。
# 例（negentropy 式嵌套工作区）：
# project_globs = ["docs/.agents/knowledge-map.md", "CHANGELOG.md"]
project_globs = []

# 规则 7「去站点化」适用的课程型系列 id（空 = 规则不激活）。
# 例：course_series_ids = ["claude-code-explained"]
course_series_ids = []

# 规则 8「下集预告卡同步」适用的系列 id（配了统一收尾装置的系列）。
next_card_series_ids = []
